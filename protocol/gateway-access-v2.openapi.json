{
  "openapi": "3.1.0",
  "info": {
    "title": "Gateway browser session and launch broker",
    "version": "2.0.0-candidate"
  },
  "servers": [
    {
      "url": "/{product_id}",
      "variables": {
        "product_id": {
          "default": "yoodesk"
        }
      }
    }
  ],
