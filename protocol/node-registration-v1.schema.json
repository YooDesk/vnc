{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yoodesk.invalid/protocol/node-registration-v1.schema.json",
  "title": "Worker enrollment request and review result",
  "oneOf": [
    {
      "$ref": "#/$defs/Request"
    },
    {
      "$ref": "#/$defs/Result"
    }
  ],
  "$defs": {
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "role",
        "node_id",
        "display_name",
        "services",
        "site_id",
        "origin",
        "region"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "role": {
          "const": "worker"
        },
        "node_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$",
          "not": {
            "const": "global"
          }
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "services": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "gateway",
              "stun",
              "turn"
            ]
          }
        },
        "site_id": {
          "type": "string",
          "maxLength": 64
        },
        "origin": {
          "type": "string",
          "maxLength": 2048
        },
        "region": {
          "type": "string",
          "maxLength": 64
        },
        "stun_urls": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 512,
            "pattern": "^stun:[^/?#@]+$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "services": {
                "contains": {
                  "const": "gateway"
                }
              }
            }
          },
          "then": {
            "properties": {
              "site_id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$",
                "not": {
                  "const": "global"
                }
              },
              "origin": {
                "type": "string",
                "pattern": "^https://[^/]+$",
                "maxLength": 2048
              }
            }
          },
          "else": {
            "properties": {
              "site_id": {
                "const": ""
              },
              "origin": {
                "const": ""
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "services": {
                "not": {
                  "contains": {
                    "const": "stun"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "stun_urls": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "Result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "application_id",
        "node_id",
        "state",
        "revision",
        "approved_services"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "application_id": {
          "type": "string",
          "minLength": 32,
          "maxLength": 128
        },
        "node_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$",
          "not": {
            "const": "global"
          }
        },
        "state": {
          "enum": [
            "pending",
            "approved",
            "rejected",
            "revoked"
          ]
        },
        "revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,15}$"
        },
        "approved_services": {
          "type": "array",
          "minItems": 0,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "gateway",
              "stun",
              "turn"
            ]
          }
        },
        "node_credential": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "approved"
              }
            }
          },
          "then": {
            "required": [
              "node_credential"
            ],
            "properties": {
              "approved_services": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "node_credential": false
            }
          }
        }
      ]
    }
  }
}
