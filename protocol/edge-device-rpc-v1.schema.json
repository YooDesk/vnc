{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:raccess:edge-device-rpc:v1",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "enum": [
            "begin",
            "commit",
            "attach",
            "renew",
            "close",
            "data_begin",
            "data_commit",
            "data_ready",
            "data_close",
            "capabilities"
          ]
        },
        "arguments": {
          "type": "object"
        }
      },
      "required": [
        "operation",
        "arguments"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "const": "capabilities"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "host_token": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                  },
                  "binding": {
                    "$ref": "#/$defs/route"
                  },
                  "attachment_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{32}$"
                  },
                  "capabilities": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "revision",
                      "protocols"
                    ],
                    "properties": {
                      "local_ip": {"type": "string", "minLength": 7, "maxLength": 15},
                      "revision": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "protocols": {
                        "type": "array",
                        "maxItems": 4,
                        "uniqueItems": true,
                        "items": {
                          "enum": [
                            "desk",
                            "ssh",
                            "rdp",
                            "vnc"
                          ]
                        }
                      }
                    }
                  }
                },
                "required": [
                  "host_token",
                  "binding",
                  "attachment_id",
                  "capabilities"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "begin"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "request_id": {
                    "type": "string",
                    "minLength": 16,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9_-]+$"
                  },
                  "host_token": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                  }
                },
                "required": [
                  "request_id",
                  "host_token"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "commit"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "challenge_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{43}$"
                  },
                  "host_token": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                  },
                  "proof": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                  }
                },
                "required": [
                  "challenge_id",
                  "host_token",
                  "proof"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "attach"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "host_token": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                  },
                  "binding": {
                    "$ref": "#/$defs/route"
                  },
                  "attachment_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{32}$"
                  }
                },
                "required": [
                  "host_token",
                  "binding",
                  "attachment_id"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "renew"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "host_token": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                  },
                  "binding": {
                    "$ref": "#/$defs/route"
                  },
                  "attachment_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{32}$"
                  },
                  "replacement_host_token": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                  },
                  "data_generation": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,18})$"
                  },
                  "data_ready": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "host_token",
                  "binding",
                  "attachment_id",
                  "data_generation",
                  "data_ready"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "close"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "host_token": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                  },
                  "binding": {
                    "$ref": "#/$defs/route"
                  },
                  "attachment_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{32}$"
                  }
                },
                "required": [
                  "host_token",
                  "binding",
                  "attachment_id"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "data_begin"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "host_token": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                  },
                  "binding": {
                    "$ref": "#/$defs/route"
                  },
                  "attachment_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{32}$"
                  },
                  "request_id": {
                    "type": "string",
                    "minLength": 16,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9_-]+$"
                  }
                },
                "required": [
                  "host_token",
                  "binding",
                  "attachment_id",
                  "request_id"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "data_commit"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "host_token": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                  },
                  "binding": {
                    "$ref": "#/$defs/route"
                  },
                  "attachment_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{32}$"
                  },
                  "challenge_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{43}$"
                  },
                  "proof": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                  },
                  "data_attachment_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{32}$"
                  }
                },
                "required": [
                  "host_token",
                  "binding",
                  "attachment_id",
                  "challenge_id",
                  "proof",
                  "data_attachment_id"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "data_ready"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "host_token": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                  },
                  "binding": {
                    "$ref": "#/$defs/route"
                  },
                  "attachment_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{32}$"
                  },
                  "data_attachment_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{32}$"
                  },
                  "data_generation": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{0,19}$"
                  }
                },
                "required": [
                  "host_token",
                  "binding",
                  "attachment_id",
                  "data_attachment_id",
                  "data_generation"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "data_close"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "host_token": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                  },
                  "binding": {
                    "$ref": "#/$defs/route"
                  },
                  "attachment_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{32}$"
                  },
                  "data_attachment_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{32}$"
                  },
                  "data_generation": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{0,19}$"
                  }
                },
                "required": [
                  "host_token",
                  "binding",
                  "attachment_id",
                  "data_attachment_id",
                  "data_generation"
                ]
              }
            }
          }
        }
      ]
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            200,
            400,
            401,
            409,
            410,
            413,
            429,
            503
          ]
        },
        "body": {
          "type": "object"
        }
      },
      "required": [
        "status",
        "body"
      ]
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "device_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "site_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "node_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "v": {
          "const": 1
        },
        "edge_connection_generation": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{32})?$"
        },
        "connector_generation": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "route_epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "lease_deadline": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        }
      },
      "required": [
        "device_id",
        "site_id",
        "node_id",
        "v",
        "edge_connection_generation",
        "connector_generation",
        "route_epoch",
        "lease_deadline"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "node_id": {
                "const": "global"
              }
            }
          },
          "then": {
            "properties": {
              "site_id": {
                "const": "global"
              },
              "edge_connection_generation": {
                "const": ""
              }
            }
          },
          "else": {
            "properties": {
              "edge_connection_generation": {
                "pattern": "^[0-9a-f]{32}$"
              }
            }
          }
        }
      ]
    }
  }
}
