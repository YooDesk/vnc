{
  "type": "object",
  "description": "RS256 grant v3 candidate; existing authorization max 900 seconds and immutable per-Viewer rate snapshot. Temporal, signature and cross-message equality checks are additional runtime invariants.",
  "properties": {
    "iss": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "aud": {
      "const": "raccess-session-v3"
    },
    "sub": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "jti": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "device_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "capability": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "target_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "policy_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "iat": {
      "type": "integer",
      "minimum": 0
    },
    "nbf": {
      "type": "integer",
      "minimum": 0
    },
    "exp": {
      "type": "integer",
      "minimum": 0
    },
    "connection_generation": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "negotiation_generation": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "scope": {
      "type": "array",
      "items": {
        "enum": [
          "session.connect",
          "screen.view",
          "input.pointer",
          "input.keyboard",
          "audio.listen",
          "clipboard.read",
          "clipboard.write",
          "files.read",
          "files.write",
          "targets.manage",
          "credentials.use",
          "credentials.persist",
          "shell.start"
        ]
      },
      "maxItems": 128,
      "minItems": 1,
      "uniqueItems": true
    },
    "lease_version": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$"
    },
    "viewer_rate": {
      "$ref": "#/$defs/viewer_rate"
    }
  },
  "required": [
    "iss",
    "aud",
    "sub",
    "jti",
    "device_id",
    "session_id",
    "capability",
    "target_id",
    "policy_revision",
    "iat",
    "nbf",
    "exp",
    "connection_generation",
    "negotiation_generation",
    "scope",
    "lease_version",
    "viewer_rate"
  ],
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:raccess:session-grant:v3",
  "$defs": {
    "viewer_rate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "from_viewer_bytes_per_second",
        "to_viewer_bytes_per_second"
      ],
      "properties": {
        "v": {
          "type": "integer",
          "const": 1
        },
        "from_viewer_bytes_per_second": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1250000000
        },
        "to_viewer_bytes_per_second": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1250000000
        }
      }
    }
  },
  "title": ""
}
