{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:raccess:stream-header:v2",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "bind"
        },
        "grant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        }
      },
      "required": [
        "kind",
        "grant"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "http"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "negotiation_generation": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "capability": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "target_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "path": {
          "type": "string",
          "pattern": "^/[a-z][a-z0-9-]{0,31}/webclient/",
          "maxLength": 4096
        }
      },
      "required": [
        "kind",
        "session_id",
        "negotiation_generation",
        "capability",
        "target_id",
        "path"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "relay"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "negotiation_generation": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        }
      },
      "required": [
        "kind",
        "session_id",
        "negotiation_generation"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "bind_result"
        },
        "ok": {
          "type": "boolean"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "lease_version": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        }
      },
      "required": [
        "kind",
        "ok"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "ok": {
                "const": false
              }
            }
          },
          "then": {
            "required": [
              "code"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "ok": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "lease_version"
            ]
          }
        }
      ]
    }
  ]
}
