  "components": {
    "securitySchemes": {
      "AdministratorSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-{product_id}_admin_session"
      }
    },
    "schemas": {
      "EnterpriseKey": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "email_domain",
              "wecom_corp_id",
              "feishu_tenant_key",
              "dingtalk_corp_id"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "kind",
          "value"
        ]
      },
      "EnterpriseWrite": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enterprise_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "revision": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,15}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "keys": {
            "type": "array",
            "maxItems": 1024,
            "items": {
              "$ref": "#/components/schemas/EnterpriseKey"
            }
          }
        },
        "required": [
          "enterprise_id",
          "revision",
          "name",
          "keys"
        ]
      },
      "RoleWrite": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enterprise_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "revision": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,15}$"
          },
          "user_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "administrator": {
            "type": "boolean"
          }
        },
        "required": [
          "enterprise_id",
          "revision",
          "user_id",
          "administrator"
        ]
      },
      "RelayWrite": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "target_type": {
            "enum": [
              "global",
              "enterprise",
              "device"
            ]
          },
          "target_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "expected_revision": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,15}$"
          },
          "relay_limit_bps": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 1250000000
          }
        },
        "required": [
          "target_type",
          "target_id",
          "expected_revision",
          "relay_limit_bps"
        ]
      },
      "RelayBatch": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "$ref": "#/components/schemas/RelayWrite"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "SMTP": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "host": {
            "type": "string",
            "maxLength": 4096
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "from": {
            "type": "string",
            "maxLength": 4096
          },
          "tls_mode": {
            "enum": [
              "tls",
              "starttls"
            ]
          },
          "username": {
            "type": "string",
            "maxLength": 4096
          },
          "from_name": {
            "type": "string",
            "maxLength": 4096
          },
          "password": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "required": [
          "host",
          "port",
          "from",
          "tls_mode"
        ]
      },
      "OIDC": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "issuer": {
            "type": "string",
            "maxLength": 4096
          },
          "client_id": {
            "type": "string",
            "maxLength": 4096
          },
          "client_secret": {
            "type": "string",
            "maxLength": 4096
          },
          "provider_hint": {
            "type": "string",
            "maxLength": 4096
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 32
          }
        },
        "required": [
          "issuer",
          "client_id",
          "client_secret",
          "provider_hint",
          "scopes"
        ]
      },
      "PasswordWrite": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "old_password": {
            "type": "string",
            "maxLength": 72
          },
          "new_password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 72
          }
        },
        "required": [
          "old_password",
          "new_password"
        ]
      },
