  "paths": {
    "/api/v2/admin/console/settings": {
      "get": {
        "operationId": "getConsoleSettings",
        "summary": "Read settings and redacted SMTP delivery health",
        "security": [
          {
            "AdministratorSession": []
          }
        ],
        "description": "Product-prefixed Global authority. Exact Host, independent administrator session and CSRF cookie; no ordinary-account elevation. No duplicate/unknown JSON fields or duplicate queries. Requests <=64 KiB, nesting <=16, transaction deadline 25 seconds. Configuration switches are stored here; this contract does not claim external provider availability.",
        "responses": {
          "200": {
            "description": "Successful data envelope. smtp_last_delivery is null until a delivery attempt, otherwise contains at (UTC date-time), delivered (boolean), stage (transport/authentication/envelope/data result category), optional smtp_code (numeric protocol status only). No SMTP reply text, credentials, recipient or verification code is exposed. Health is process-local and resets on restart."
          },
          "400": {
            "description": "Invalid query/body/Origin/CSRF"
          },
          "401": {
            "description": "Administrator required"
          },
          "404": {
            "description": "Missing authority resource"
          },
          "409": {
            "description": "Revision conflict; reread before manual retry"
          },
          "429": {
            "description": "Hash capacity or login rate exceeded"
          },
          "503": {
            "description": "Authority unavailable; do not replay writes automatically"
          }
        }
      },
      "post": {
        "operationId": "postConsoleSettings",
        "security": [
          {
            "AdministratorSession": []
          }
        ],
        "description": "Product-prefixed Global authority. Exact Host, independent administrator session and CSRF cookie; no ordinary-account elevation. No duplicate/unknown JSON fields or duplicate queries. Requests <=64 KiB, nesting <=16, transaction deadline 25 seconds. Configuration switches are stored here; this contract does not claim external provider availability.",
        "responses": {
          "200": {
            "description": "Successful data envelope"
          },
          "400": {
            "description": "Invalid query/body/Origin/CSRF"
          },
          "401": {
            "description": "Administrator required"
          },
          "404": {
            "description": "Missing authority resource"
          },
          "409": {
            "description": "Revision conflict; reread before manual retry"
          },
          "429": {
            "description": "Hash capacity or login rate exceeded"
          },
          "503": {
            "description": "Authority unavailable; do not replay writes automatically"
          }
        },
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Admin-CSRF",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettingsWrite"
              }
            }
          }
        }
      }
    },
