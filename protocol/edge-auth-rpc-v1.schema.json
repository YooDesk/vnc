                "properties": {
                  "method": {
                    "enum": [
                      "GET",
                      "POST"
                    ]
                  },
                  "path": {
                    "type": "string",
                    "maxLength": 8192
                  },
                  "body": {
                    "type": "string",
                    "maxLength": 8192
                  },
                  "source_hint": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "headers": {
                    "type": "object",
                    "maxProperties": 7,
                    "propertyNames": {
                      "enum": [
                        "Content-Type",
                        "Authorization",
                        "DPoP",
                        "Origin",
                        "X-CSRF-Token",
                        "X-Request-ID",
                        "X-Browser-Refresh"
                      ]
                    },
                    "additionalProperties": {
                      "type": "string",
                      "maxLength": 8192
                    }
                  },
                  "cookies": {
                    "type": "object",
                    "maxProperties": 16,
                    "propertyNames": {
                      "pattern": "^(__Host-[a-z][a-z0-9-]{0,31}_account_[a-z_-]+|__Secure-[a-z][a-z0-9-]{0,31}-login)$"
                    },
                    "additionalProperties": {
                      "type": "string",
                      "maxLength": 4096
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "account_http"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "method",
                  "path",
                  "binding",
                  "body",
                  "source_hint"
                ],
                "properties": {
                  "method": {
                    "enum": [
                      "GET",
                      "POST"
                    ]
                  },
                  "path": {
                    "type": "string",
                    "maxLength": 8192
                  },
                  "binding": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "body": {
                    "type": "string",
                    "maxLength": 8192
                  },
                  "source_hint": {
                    "type": "string",
                    "maxLength": 128
                  }
                }
              }
            }
          }
        }
      ]
