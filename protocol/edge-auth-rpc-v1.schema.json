                "properties": {
                  "cookie_token": {
                    "oneOf": [
                      {
                        "type": "string",
                        "minLength": 16,
                        "maxLength": 128,
                        "pattern": "^[A-Za-z0-9_-]+$"
                      },
                      {
                        "type": "string",
                        "minLength": 38,
                        "maxLength": 1030,
                        "pattern": "^guest:[A-Za-z0-9_-]+$"
                      }
                    ]
                  },
                  "csrf_token": {
                    "type": "string",
                    "minLength": 16,
                    "maxLength": 128
                  },
                  "session_id": {
                    "type": "string",
                    "minLength": 16,
                    "maxLength": 128
                  },
                  "request_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "request": {
                    "$ref": "#/$defs/remote_renew"
                  }
                },
                "required": [
                  "cookie_token",
                  "csrf_token",
                  "session_id",
                  "request_id",
                  "request"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "remote_negotiate"
              }
            }
