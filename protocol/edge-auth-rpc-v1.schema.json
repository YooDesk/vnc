                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      }
                    },
                    "required": [
                      "command",
                      "device_id"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "command": {
                        "enum": [
                          "read",
                          "bind",
                          "renew"
                        ]
                      },
                      "session_id": {
                        "type": "string",
                        "minLength": 16,
                        "maxLength": 128,
                        "pattern": "^[A-Za-z0-9_-]+$"
                      },
                      "cookie_token": {
                        "type": "string",
                        "minLength": 38,
                        "maxLength": 1030,
                        "pattern": "^guest:[A-Za-z0-9_-]+$"
                      },
                      "csrf_token": {
                        "type": "string",
                        "minLength": 16,
                        "maxLength": 128,
                        "pattern": "^[A-Za-z0-9_-]+$"
                      }
                    },
                    "required": [
                      "command",
                      "session_id",
                      "cookie_token",
                      "csrf_token"
                    ]
                  }
                ]
              }
            }
          }
        },
        {
