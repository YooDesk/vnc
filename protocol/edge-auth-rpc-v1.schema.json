    "response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            200,
            400,
            401,
            403,
            409,
            410,
            413,
            429,
            503
          ]
        },
        "body": {
          "type": "object"
        }
      },
      "required": [
        "status",
        "body"
      ]
    },
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            200,
            400,
            401,
            403,
            409,
            410,
            413,
            429,
            503
          ]
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "total": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "data": {
          "type": "string",
          "maxLength": 24000,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      },
      "required": [
        "status",
        "index",
        "total",
        "length",
        "digest",
        "data"
      ]
    },
    "remote_create": {
      "type": "object",
      "properties": {
        "device_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "capability": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "target_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "requested_scopes": {
          "type": "array",
          "items": {
            "enum": [
              "session.connect",
              "screen.view",
              "input.pointer",
              "input.keyboard",
              "audio.listen",
              "clipboard.read",
              "clipboard.write",
              "files.read",
              "files.write",
              "targets.manage",
              "credentials.use",
              "credentials.persist",
              "shell.start"
            ]
          },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        }
      },
      "required": [
        "device_id",
        "capability",
        "target_id"
      ],
      "additionalProperties": false
    },
    "remote_renew": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_lease_version"
      ],
      "properties": {
        "expected_lease_version": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        }
      }
    },
    "remote_negotiate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_negotiation_generation",
        "path"
      ],
      "properties": {
        "expected_negotiation_generation": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "path": {
          "enum": [
            "stun",
            "turn",
            "websocket"
          ]
        }
      }
    },
    "remote_release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_negotiation_generation"
      ],
      "properties": {
        "expected_negotiation_generation": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        }
      }
    }
  }
