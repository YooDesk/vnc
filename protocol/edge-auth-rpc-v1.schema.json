          "then": {
            "properties": {
              "arguments": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "cookie_token": {
                    "oneOf": [
                      {
                        "type": "string",
                        "minLength": 16,
                        "maxLength": 128,
                        "pattern": "^[A-Za-z0-9_-]+$"
                      },
                      {
                        "type": "string",
                        "minLength": 38,
                        "maxLength": 1030,
                        "pattern": "^guest:[A-Za-z0-9_-]+$"
                      }
                    ]
                  },
                  "csrf_token": {
                    "type": "string",
                    "minLength": 16,
                    "maxLength": 128
                  },
                  "session_id": {
                    "type": "string",
                    "minLength": 16,
                    "maxLength": 128
                  },
                  "request_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
