                "required": [
                  "cookie_token",
                  "csrf_token",
                  "session_id",
                  "request_id",
                  "request"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "remote_release"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "type": "object",
