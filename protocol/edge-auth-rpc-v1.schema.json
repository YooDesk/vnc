                },
                "required": [
                  "cookie_token",
                  "csrf_token",
                  "session_id",
                  "request_id",
                  "request"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "connector_http"
              }
            }
          },
          "then": {
            "properties": {
              "arguments": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "method",
                  "path",
                  "body",
                  "headers",
                  "cookies",
                  "source_hint"
