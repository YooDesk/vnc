                "properties": {
                  "cookie_token": {
                    "oneOf": [
                      {
                        "type": "string",
                        "minLength": 16,
                        "maxLength": 128,
                        "pattern": "^[A-Za-z0-9_-]+$"
                      },
                      {
                        "type": "string",
                        "minLength": 38,
                        "maxLength": 1030,
                        "pattern": "^guest:[A-Za-z0-9_-]+$"
