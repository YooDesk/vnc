                    "type": "string",
                    "minLength": 16,
                    "maxLength": 128
                  },
                  "request_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "request": {
                    "$ref": "#/$defs/remote_release"
