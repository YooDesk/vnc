          "if": {"properties": {"operation": {"const": "edge_child_admin"}}},
          "then": {"properties": {"arguments": {
            "type": "object", "additionalProperties": false, "required": ["action"],
            "properties": {
              "action": {"enum": ["list", "lookup", "invite", "approve", "reject", "submit"]},
              "node_id": {"type": "string", "minLength": 1, "maxLength": 64},
              "token": {"type": "string", "minLength": 43, "maxLength": 43},
              "request": {"type": "object"}
            }
          }}}
        },
        {
          "if": {"properties": {"operation": {"const": "edge_child_tree"}}},
          "then": {"properties": {"arguments": {"type": "object", "maxProperties": 0}}}
        },
        {
          "if": {"properties": {"operation": {"const": "admin_device_remark"}}},
          "then": {"properties": {"arguments": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "device_id": {"type": "string", "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]{0,127}$"},
              "expected_remark": {"type": "string", "maxLength": 100},
              "remark": {"type": "string", "maxLength": 100}
            },
            "required": ["device_id", "expected_remark", "remark"]
          }}}
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "viewer_session"
              }
            }
          },
          "then": {
