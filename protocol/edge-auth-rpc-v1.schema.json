            "properties": {
              "arguments": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "binding": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "request_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
