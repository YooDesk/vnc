                    ]
                  },
                  "csrf_token": {
                    "type": "string",
                    "minLength": 16,
                    "maxLength": 128
                  },
                  "session_id": {
                    "type": "string",
                    "minLength": 16,
                    "maxLength": 128
                  }
                },
                "required": [
                  "cookie_token",
                  "csrf_token",
                  "session_id"
                ]
              }
