            "begin",
            "complete",
            "session",
            "devices",
            "csrf",
            "revoke",
            "refresh",
            "refresh_ack",
            "remote_create",
            "remote_read",
            "remote_revoke",
            "remote_renew",
            "remote_negotiate",
            "remote_release",
