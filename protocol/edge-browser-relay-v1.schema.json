{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:raccess:edge-browser-relay:v1",
  "$defs": {
    "open": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "session_id",
        "cookie_token",
        "csrf_token",
        "grant",
        "negotiation_generation"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "cookie_token": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "string",
              "minLength": 38,
              "maxLength": 1030,
              "pattern": "^guest:[A-Za-z0-9_-]+$"
            }
          ]
        },
        "resource_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[^/].*"
        },
        "upgrade": {
          "const": true
        },
        "csrf_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "grant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20480
        },
        "negotiation_generation": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        }
      },
      "dependentRequired": {
        "upgrade": [
          "resource_path"
        ]
      }
    },
    "reply": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "v",
            "status",
            "permit"
          ],
          "properties": {
            "v": {
              "const": 1
            },
            "status": {
              "const": 200
            },
            "permit": {
              "allOf": [
                {
                  "$ref": "urn:raccess:edge-session:v1#/$defs/install/properties/permit"
                },
                {
                  "oneOf": [
                    {
                      "properties": {
                        "header": {
                          "properties": {
                            "stream_kind": {
                              "const": "relay"
                            }
                          }
                        },
                        "stream": {
                          "properties": {
                            "kind": {
                              "const": "relay"
                            }
                          }
                        }
                      }
                    },
                    {
                      "properties": {
                        "header": {
                          "properties": {
                            "stream_kind": {
                              "const": "http"
                            }
                          }
                        },
                        "stream": {
                          "properties": {
                            "kind": {
                              "const": "http"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "v",
            "status"
          ],
          "properties": {
            "v": {
              "const": 1
            },
            "status": {
              "enum": [
                401,
                403,
                409,
                429,
                503
              ]
            }
          }
        }
      ]
    }
  }
}
