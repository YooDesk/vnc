{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:raccess:ice-credential:v1",
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "negotiation_generation",
        "device_id",
        "owner_type",
        "owner_id",
        "endpoint_role",
        "policy_revision"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "negotiation_generation": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "device_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "owner_type": {
          "enum": [
            "user",
            "enterprise"
          ]
        },
        "owner_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "endpoint_role": {
          "enum": [
            "browser",
            "connector"
          ]
        },
        "policy_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        }
      }
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credential_id",
        "binding_version",
        "scope",
        "config_revision",
        "username",
        "realm",
        "auth_key",
        "credential_expires_at",
        "authorization_expires_at",
        "max_allocations"
      ],
      "properties": {
        "credential_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "binding_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "config_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "username": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "realm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\x00-\\x20\\x7f]+$"
        },
        "auth_key": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "credential_expires_at": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "authorization_expires_at": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_allocations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "revoke": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credential_id",
        "binding_version",
        "scope"
      ],
      "properties": {
        "credential_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "binding_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "scope": {
          "$ref": "#/$defs/scope"
        }
      }
    },
    "ack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credential_id",
        "binding_version",
        "operation",
        "command_digest",
        "accepted"
      ],
      "properties": {
        "credential_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "binding_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "operation": {
          "enum": [
            "install",
            "revoke"
          ]
        },
        "command_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "accepted": {
          "type": "boolean"
        },
        "error_code": {
          "enum": [
            "invalid_binding",
            "stale",
            "capacity",
            "unavailable"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "accepted": {
                "const": false
              }
            }
          },
          "then": {
            "required": [
              "error_code"
            ]
          },
          "else": {
            "properties": {
              "error_code": false
            }
          }
        }
      ]
    },
    "retirement_query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original_boot_id",
        "original_generation"
      ],
      "properties": {
        "original_boot_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "original_generation": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        }
      }
    },
    "retirement_ack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original_boot_id",
        "original_generation",
        "query_digest",
        "retired"
      ],
      "properties": {
        "original_boot_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "original_generation": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "query_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "retired": {
          "type": "boolean"
        }
      }
    },
    "retirement_confirm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original_boot_id",
        "original_generation",
        "proof_digest"
      ],
      "properties": {
        "original_boot_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "original_generation": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "proof_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "retirement_confirm_ack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original_boot_id",
        "original_generation",
        "confirm_digest",
        "accepted"
      ],
      "properties": {
        "original_boot_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "original_generation": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "confirm_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "accepted": {
          "type": "boolean"
        }
      }
    },
    "retirement_list": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "after"
      ],
      "properties": {
        "after": {
          "type": "string",
          "pattern": "^(?:|[0-9a-f]{32}/[0-9a-f]{32})$",
          "maxLength": 65
        }
      }
    },
    "retirement_list_ack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_digest",
        "entries",
        "next"
      ],
      "properties": {
        "query_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "entries": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/retirement_query"
          }
        },
        "next": {
          "type": "string",
          "pattern": "^(?:|[0-9a-f]{32}/[0-9a-f]{32})$",
          "maxLength": 65
        }
      }
    }
  }
}
