                }
              }
            }
          },
          "default": {
            "description": "Structured failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransferCreate"
              }
            }
          }
        }
      }
    },
    "/sessions/{business_session_id}/transfers/{transfer_id}/": {
      "get": {
        "operationId": "getSftpTransfer",
        "parameters": [
          {
            "$ref": "#/components/parameters/business_session_id"
          },
          {
            "$ref": "#/components/parameters/transfer_id"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Transfer"
                }
              }
            }
          },
          "default": {
            "description": "Structured failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "cancelSftpTransfer",
        "parameters": [
          {
            "$ref": "#/components/parameters/business_session_id"
          },
          {
            "$ref": "#/components/parameters/transfer_id"
          },
          {
            "$ref": "#/components/parameters/RequestId"
          }
        ],
        "responses": {
          "204": {
            "description": "Success"
          },
          "default": {
            "description": "Structured failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/sessions/{business_session_id}/transfers/{transfer_id}/complete/": {
      "post": {
        "operationId": "completeSftpTransfer",
        "parameters": [
          {
            "$ref": "#/components/parameters/business_session_id"
          },
          {
            "$ref": "#/components/parameters/transfer_id"
          },
          {
            "$ref": "#/components/parameters/RequestId"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Transfer"
                }
              }
            }
          },
          "default": {
            "description": "Structured failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/sessions/{business_session_id}/transfers/{transfer_id}/content/": {
      "get": {
        "operationId": "downloadSftpContent",
        "parameters": [
          {
            "$ref": "#/components/parameters/business_session_id"
          },
          {
            "$ref": "#/components/parameters/transfer_id"
          },
          {
            "name": "Range",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "default": {
            "description": "Structured failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "206": {
            "description": "Requested source byte range",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "uploadSftpChunk",
        "parameters": [
          {
            "$ref": "#/components/parameters/business_session_id"
          },
          {
            "$ref": "#/components/parameters/transfer_id"
          },
          {
            "$ref": "#/components/parameters/RequestId"
          },
          {
            "name": "Upload-Offset",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]+$",
              "maxLength": 20
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Success",
            "headers": {
              "Upload-Offset": {
                "schema": {
                  "type": "string",
                  "pattern": "^[0-9]+$",
                  "maxLength": 20
                },
                "description": "Server-confirmed committed offset"
              }
            }
          },
          "default": {
            "description": "Structured failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SessionCreate": {
        "type": "object",
        "properties": {
          "protocol_version": {
            "const": 1
          },
          "target_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "credential_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "options": {
            "type": "object",
            "properties": {
              "cols": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "rows": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "read_only": {
                "type": "boolean"
              },
              "video_codecs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "audio_codecs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "display_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "client_features": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "maxItems": 128
          }
        },
        "required": [
          "protocol_version",
          "target_id",
          "options",
          "client_features"
        ],
        "additionalProperties": false
      },
      "SessionResponse": {
        "type": "object",
        "properties": {
          "v": {
            "const": 1
          },
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "data": {
            "type": "object",
            "properties": {
              "business_session_id": {
                "type": "string",
                "format": "uuid"
              },
              "state": {
                "enum": [
                  "created",
                  "connecting",
                  "waiting_challenge",
                  "ready",
                  "reconnecting",
                  "closing",
                  "closed",
                  "failed"
                ]
              },
              "stream_profile": {
                "enum": [
                  "terminal.v1",
                  "sftp.v1",
                  "rfb.v1",
                  "rdcleanpath.v1",
                  "rustdesk-message.v1"
                ]
              },
              "features": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "maxItems": 128
              },
              "event_url": {
                "type": "string",
                "pattern": "^/[a-z][a-z0-9-]{0,31}/webclient/"
              },
              "stream_url": {
                "type": "string",
                "pattern": "^/[a-z][a-z0-9-]{0,31}/webclient/"
              }
            },
            "required": [
              "business_session_id",
              "state",
              "stream_profile",
              "features",
              "event_url",
              "stream_url"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "v",
          "request_id",
          "data"
        ],
        "additionalProperties": false
      },
      "Event": {
        "type": "object",
        "properties": {
          "v": {
            "const": 1
          },
          "type": {
            "enum": [
              "session.snapshot",
              "session.state",
              "challenge.created",
              "challenge.resolved",
              "transfer.progress",
              "transfer.completed",
              "transfer.failed",
              "transfer.cancelled",
              "session.error"
            ]
          },
          "event_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}$"
          },
          "business_session_id": {
            "type": "string",
            "format": "uuid"
          },
          "payload": {
            "type": "object"
          }
        },
        "required": [
          "v",
          "type",
          "event_id",
          "business_session_id",
          "payload"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "v": {
            "const": 1
          },
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "message": {
                "type": "string",
                "maxLength": 4096
              },
              "retryable": {
                "type": "boolean"
              },
              "details": {
                "type": "object"
              }
            },
            "required": [
              "code",
              "message",
              "retryable"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "v",
          "request_id",
          "error"
        ],
        "additionalProperties": false
      },
      "CredentialCreate": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "password",
