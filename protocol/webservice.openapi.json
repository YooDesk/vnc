                "$ref": "#/components/schemas/TargetPatch"
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteBusinessTarget",
        "parameters": [
          {
            "$ref": "#/components/parameters/target_id"
          },
          {
            "$ref": "#/components/parameters/RequestId"
          },
          {
            "name": "terminate_sessions",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Success"
          },
          "default": {
            "description": "Structured failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/sessions/{business_session_id}/entries/": {
      "get": {
        "operationId": "listSftpEntries",
        "parameters": [
          {
            "$ref": "#/components/parameters/business_session_id"
          },
          {
            "name": "path",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 4096
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "default": {
            "description": "Structured failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createSftpDirectory",
        "parameters": [
          {
            "$ref": "#/components/parameters/business_session_id"
          },
          {
            "$ref": "#/components/parameters/RequestId"
          }
        ],
        "responses": {
          "201": {
            "description": "Success"
          },
          "default": {
            "description": "Structured failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DirectoryMutation"
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "renameSftpEntry",
        "parameters": [
          {
            "$ref": "#/components/parameters/business_session_id"
          },
          {
            "$ref": "#/components/parameters/RequestId"
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "default": {
            "description": "Structured failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DirectoryMutation"
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteSftpEntry",
        "parameters": [
          {
            "$ref": "#/components/parameters/business_session_id"
          },
          {
            "$ref": "#/components/parameters/RequestId"
          },
          {
            "name": "path",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 4096
            }
          },
          {
            "name": "recursive",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Success"
          },
          "default": {
            "description": "Structured failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/sessions/{business_session_id}/transfers/": {
      "post": {
        "operationId": "createSftpTransfer",
