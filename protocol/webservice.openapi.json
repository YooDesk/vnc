{
  "openapi": "3.1.0",
  "info": {
    "title": "WebService Business Protocol",
    "version": "1.0.0",
    "description": "FROZEN v1; templates expand product identity. No implementation is implied."
  },
  "servers": [
    {
      "url": "/{product_id}/webclient/{capability}/api/v1",
      "variables": {
        "product_id": {
          "default": "yoodesk"
        },
        "capability": {
          "default": "ssh",
          "enum": [
            "desk",
            "ssh",
            "sftp",
            "vnc",
            "rdp",
            "shell"
          ]
        }
      }
    }
  ],
  "security": [
    {
      "BusinessSession": []
    }
  ],
  "paths": {
    "/capabilities/": {
      "get": {
        "operationId": "getCapabilities",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            }
          },
          "default": {
            "description": "Structured failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
